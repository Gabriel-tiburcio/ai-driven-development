@page
@model RecreacaoInfantilModel
@{
    ViewData["Title"] = "Recreação Infantil";
    Layout = "_Layout";
}

<h1>Recreação Infantil</h1>

<div class="card">
    <details>
        <summary>Nova atividade</summary>
        <form method="post" style="margin-top:1rem;">
            <div class="field">
                <label asp-for="Input.Name">Nome</label>
                <input asp-for="Input.Name" required />
            </div>
            <div class="field">
                <label asp-for="Input.AgeRange">Faixa etária</label>
                <input asp-for="Input.AgeRange" placeholder="4 a 8 anos" required />
            </div>
            <div class="field">
                <label asp-for="Input.Schedule">Horário</label>
                <input asp-for="Input.Schedule" placeholder="Seg a sex, 10h-12h" required />
            </div>
            <div class="field">
                <label asp-for="Input.Location">Local</label>
                <input asp-for="Input.Location" required />
            </div>
            <div class="field">
                <label asp-for="Input.Description">Descrição</label>
                <textarea asp-for="Input.Description"></textarea>
            </div>
            <div class="field">
                <label asp-for="Input.ImageUrl">URL da foto</label>
                <input asp-for="Input.ImageUrl" type="url" placeholder="https://..." />
            </div>
            <button type="submit">Salvar</button>
        </form>
    </details>
</div>

@if (Model.Activities.Count == 0)
{
    <p class="empty-note">Nenhuma atividade infantil cadastrada ainda.</p>
}
else
{
    <div class="docket-wall">
        @foreach (var k in Model.Activities)
        {
            <div class="docket-card">
                <div class="docket-card-photo">
                    @if (!string.IsNullOrWhiteSpace(k.ImageUrl))
                    {
                        <img src="@k.ImageUrl" alt="" />
                    }
                    else
                    {
                        <span class="docket-card-photo-empty">Sem foto</span>
                    }
                </div>
                <span class="docket-card-category">@k.AgeRange</span>
                <h3>@k.Name</h3>
                <p class="docket-card-meta">@k.Schedule &middot; @k.Location</p>
                <div class="card-actions">
                    <button type="button" class="btn secondary" data-modal-target="edit-@k.Id">Editar</button>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@k.Id"
                          class="js-confirm-delete" data-confirm-message="Excluir a atividade @k.Name?">
                        <button type="submit" class="danger">Excluir</button>
                    </form>
                </div>

                <dialog id="edit-@k.Id" class="modal">
                    <h3>Editar atividade</h3>
                    <form method="post" asp-page-handler="Edit" asp-route-id="@k.Id">
                        <div class="field">
                            <label>Nome</label>
                            <input name="name" value="@k.Name" required />
                        </div>
                        <div class="field">
                            <label>Faixa etária</label>
                            <input name="ageRange" value="@k.AgeRange" required />
                        </div>
                        <div class="field">
                            <label>Horário</label>
                            <input name="schedule" value="@k.Schedule" required />
                        </div>
                        <div class="field">
                            <label>Local</label>
                            <input name="location" value="@k.Location" required />
                        </div>
                        <div class="field">
                            <label>Descrição</label>
                            <textarea name="description">@k.Description</textarea>
                        </div>
                        <div class="field">
                            <label>URL da foto</label>
                            <input name="imageUrl" type="url" value="@k.ImageUrl" placeholder="https://..." />
                        </div>
                        <div class="field">
                            <label>Status</label>
                            <select name="isActive">
                                <option value="true" selected="@k.IsActive">Ativa</option>
                                <option value="false" selected="@(!k.IsActive)">Inativa</option>
                            </select>
                        </div>
                        <div class="modal-actions">
                            <button type="button" class="btn secondary" data-modal-close>Cancelar</button>
                            <button type="submit">Salvar alterações</button>
                        </div>
                    </form>
                </dialog>
            </div>
        }
    </div>
}

<h2 style="margin-top:2rem;">Inscrições</h2>

@if (Model.Enrollments.Count == 0)
{
    <p class="empty-note">Nenhuma inscrição registrada ainda.</p>
}
else
{
    <div class="docket-wall">
        @foreach (var en in Model.Enrollments)
        {
            <div class="docket-card">
                <span class="docket-card-category">@en.KidsActivityName</span>
                <h3>@en.ChildName (@en.ChildAge)</h3>
                <div class="docket-card-meta">
                    <span>Responsável: quarto @en.GuardianRoomNumber</span>
                    <span>@en.Status</span>
                </div>
            </div>
        }
    </div>
}
