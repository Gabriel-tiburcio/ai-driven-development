<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AllStay Backoffice</title>
    <link rel="icon" type="image/png" href="~/img/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- impeccable:direction
    THESIS: brief-pinned — Apple's own System Settings / App Store Connect register, replacing the prior switchboard identity per explicit user request. Operate mode: quiet neutral chrome over marketing pacing.
    OWN-WORLD: near-white grounds, a fixed light sidebar (Apple Settings convention), grouped inset lists and hairline dividers, Inter, AllStay orange reserved for category/state emphasis only.
    STORY: staff open the app to a persistent sidebar, scan the activity catalog as a clean tile grid, and manage reservations as a precise grouped list.
    FIRST VIEWPORT: (per-page; see Activities.cshtml) sidebar + a light, hairline-divided content area — no dark panel, no marketing hero.
    FORM: brief-pinned (apple-design skill), no direction roll — user explicitly requested this world over the prior switchboard direction.
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md.
    -->
    <div class="app-shell">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <aside class="app-sidebar">
                <a class="brand" href="/">
                    <img src="~/img/logo.png" alt="AllStay" height="24" />
                    All<span class="text-brand">Stay</span>
                </a>
                <nav class="app-nav">
                    <a href="/Activities">Atividades</a>
                    <a href="/Reservations">Reservas</a>
                </nav>
                <div class="sidebar-footer">
                    <span class="staff-name">@User.GetFullName()<br />@User.GetHotelName()</span>
                    <form method="post" asp-page="/Logout" style="display:inline;">
                        <button type="submit" class="link-button">Sair</button>
                    </form>
                </div>
            </aside>
        }

        <main class="app-main @(User.Identity?.IsAuthenticated == true ? "" : "app-main-bare")">
            @RenderBody()
        </main>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
