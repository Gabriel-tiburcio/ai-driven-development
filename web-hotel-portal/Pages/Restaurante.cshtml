@page
@model RestauranteModel
@{
    ViewData["Title"] = "Restaurante";
    Layout = "_Layout";
}

<h1>Restaurante</h1>

<div class="card">
    <details>
        <summary>Novo restaurante</summary>
        <form method="post" style="margin-top:1rem;">
            <div class="field">
                <label asp-for="Input.Name">Nome</label>
                <input asp-for="Input.Name" required />
            </div>
            <div class="field">
                <label asp-for="Input.CuisineType">Tipo de cozinha</label>
                <input asp-for="Input.CuisineType" placeholder="Italiana, Frutos do mar..." required />
            </div>
            <div class="field">
                <label asp-for="Input.Hours">Horário de funcionamento</label>
                <input asp-for="Input.Hours" placeholder="Todos os dias, 12h-23h" required />
            </div>
            <div class="field">
                <label asp-for="Input.Description">Descrição</label>
                <textarea asp-for="Input.Description" required></textarea>
            </div>
            <div class="field">
                <label asp-for="Input.MenuHighlights">Destaques do cardápio (um por linha)</label>
                <textarea asp-for="Input.MenuHighlights" placeholder="Risoto de camarão&#10;Filé ao molho madeira"></textarea>
            </div>
            <div class="field">
                <label asp-for="Input.ImageUrl">URL da foto</label>
                <input asp-for="Input.ImageUrl" type="url" placeholder="https://..." />
            </div>
            <button type="submit">Salvar</button>
        </form>
    </details>
</div>

@if (Model.Restaurants.Count == 0)
{
    <p class="empty-note">Nenhum restaurante cadastrado ainda.</p>
}
else
{
    <div class="docket-wall">
        @foreach (var r in Model.Restaurants)
        {
            <div class="docket-card">
                <div class="docket-card-photo">
                    @if (!string.IsNullOrWhiteSpace(r.ImageUrl))
                    {
                        <img src="@r.ImageUrl" alt="" />
                    }
                    else
                    {
                        <span class="docket-card-photo-empty">Sem foto</span>
                    }
                </div>
                <span class="docket-card-category">@r.CuisineType</span>
                <h3>@r.Name</h3>
                <p class="docket-card-meta">@r.Hours</p>
                <div class="card-actions">
                    <button type="button" class="btn secondary" data-modal-target="edit-@r.Id">Editar</button>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@r.Id"
                          class="js-confirm-delete" data-confirm-message="Excluir o restaurante @r.Name?">
                        <button type="submit" class="danger">Excluir</button>
                    </form>
                </div>

                <dialog id="edit-@r.Id" class="modal">
                    <h3>Editar restaurante</h3>
                    <form method="post" asp-page-handler="Edit" asp-route-id="@r.Id">
                        <div class="field">
                            <label>Nome</label>
                            <input name="name" value="@r.Name" required />
                        </div>
                        <div class="field">
                            <label>Tipo de cozinha</label>
                            <input name="cuisineType" value="@r.CuisineType" required />
                        </div>
                        <div class="field">
                            <label>Horário de funcionamento</label>
                            <input name="hours" value="@r.Hours" required />
                        </div>
                        <div class="field">
                            <label>Descrição</label>
                            <textarea name="description" required>@r.Description</textarea>
                        </div>
                        <div class="field">
                            <label>Destaques do cardápio (um por linha)</label>
                            <textarea name="menuHighlights">@string.Join("\n", r.MenuHighlights)</textarea>
                        </div>
                        <div class="field">
                            <label>URL da foto</label>
                            <input name="imageUrl" type="url" value="@r.ImageUrl" placeholder="https://..." />
                        </div>
                        <div class="field">
                            <label>Status</label>
                            <select name="isActive">
                                <option value="true" selected="@r.IsActive">Ativo</option>
                                <option value="false" selected="@(!r.IsActive)">Inativo</option>
                            </select>
                        </div>
                        <div class="modal-actions">
                            <button type="button" class="btn secondary" data-modal-close>Cancelar</button>
                            <button type="submit">Salvar alterações</button>
                        </div>
                    </form>
                </dialog>
            </div>
        }
    </div>
}
