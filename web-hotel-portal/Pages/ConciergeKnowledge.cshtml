@page
@model ConciergeKnowledgeModel
@{
    ViewData["Title"] = "Concierge Premium";
    Layout = "_Layout";
}

<h1>Concierge Premium</h1>
<p class="muted">Conteúdo e instruções que vão "treinar" o concierge com IA. Na POC o chat do hóspede ainda é uma prévia visual — este conteúdo é a base para quando a IA entrar em produção.</p>

<div class="card">
    <details>
        <summary>Nova nota de conhecimento</summary>
        <form method="post" style="margin-top:1rem;">
            <div class="field">
                <label asp-for="Input.Title">Título</label>
                <input asp-for="Input.Title" placeholder="Política de late check-out" required />
            </div>
            <div class="field">
                <label asp-for="Input.Content">Conteúdo</label>
                <textarea asp-for="Input.Content" required></textarea>
            </div>
            <button type="submit">Salvar</button>
        </form>
    </details>
</div>

@if (Model.Entries.Count == 0)
{
    <p class="empty-note">Nenhuma nota cadastrada ainda.</p>
}
else
{
    <div class="docket-wall">
        @foreach (var entry in Model.Entries)
        {
            <div class="docket-card">
                <h3>@entry.Title</h3>
                <p>@entry.Content</p>
                <div class="docket-card-meta">
                    <span>@entry.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</span>
                </div>
                <div class="card-actions">
                    <button type="button" class="btn secondary" data-modal-target="edit-@entry.Id">Editar</button>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@entry.Id"
                          class="js-confirm-delete" data-confirm-message="Excluir a nota &quot;@entry.Title&quot;?">
                        <button type="submit" class="danger">Excluir</button>
                    </form>
                </div>

                <dialog id="edit-@entry.Id" class="modal">
                    <h3>Editar nota</h3>
                    <form method="post" asp-page-handler="Edit" asp-route-id="@entry.Id">
                        <div class="field">
                            <label>Título</label>
                            <input name="title" value="@entry.Title" required />
                        </div>
                        <div class="field">
                            <label>Conteúdo</label>
                            <textarea name="content" required>@entry.Content</textarea>
                        </div>
                        <div class="modal-actions">
                            <button type="button" class="btn secondary" data-modal-close>Cancelar</button>
                            <button type="submit">Salvar alterações</button>
                        </div>
                    </form>
                </dialog>
            </div>
        }
    </div>
}
