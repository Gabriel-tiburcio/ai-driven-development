@page
@model LoginModel
@{
    ViewData["Title"] = "Admin";
    Layout = "_AdminLoginLayout";
}

<div class="login-shell">
    <div class="card login-card">
        <h1>Acesso administrativo</h1>
        <p>Gestão de hotéis, equipes e leads do AllStay.</p>

        @if (Model.ErrorMessage is not null)
        {
            <div class="alert-error">@Model.ErrorMessage</div>
        }

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="field">
                <label asp-for="Input.Password">Senha de administrador</label>
                <input asp-for="Input.Password" type="password" autocomplete="current-password" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <button type="submit" style="width:100%;">Entrar</button>
        </form>
    </div>
</div>
