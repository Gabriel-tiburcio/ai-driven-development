@page
@model EventosModel
@{
    ViewData["Title"] = "Eventos";
    Layout = "_Layout";
}

<h1>Eventos</h1>

<div class="card">
    <details>
        <summary>Novo evento</summary>
        <form method="post" style="margin-top:1rem;">
            <div class="field">
                <label asp-for="Input.Name">Nome</label>
                <input asp-for="Input.Name" required />
            </div>
            <div class="field">
                <label asp-for="Input.Category">Categoria</label>
                <input asp-for="Input.Category" placeholder="Música, Gastronomia, Festa..." required />
            </div>
            <div class="field">
                <label asp-for="Input.Description">Descrição</label>
                <textarea asp-for="Input.Description"></textarea>
            </div>
            <div class="field">
                <label asp-for="Input.EventDate">Data</label>
                <input asp-for="Input.EventDate" type="date" required />
            </div>
            <div class="field">
                <label asp-for="Input.StartTime">Horário</label>
                <input asp-for="Input.StartTime" type="time" required />
            </div>
            <div class="field">
                <label asp-for="Input.Location">Local</label>
                <input asp-for="Input.Location" required />
            </div>
            <div class="field">
                <label asp-for="Input.ImageUrl">URL da foto</label>
                <input asp-for="Input.ImageUrl" type="url" placeholder="https://..." />
            </div>
            <button type="submit">Salvar</button>
        </form>
    </details>
</div>

@if (Model.Events.Count == 0)
{
    <p class="empty-note">Nenhum evento cadastrado ainda.</p>
}
else
{
    <div class="docket-wall">
        @foreach (var evt in Model.Events)
        {
            <div class="docket-card">
                <div class="docket-card-photo">
                    @if (!string.IsNullOrWhiteSpace(evt.ImageUrl))
                    {
                        <img src="@evt.ImageUrl" alt="" />
                    }
                    else
                    {
                        <span class="docket-card-photo-empty">Sem foto</span>
                    }
                </div>
                <span class="docket-card-category">@evt.Category</span>
                <h3>@evt.Name</h3>
                <div class="docket-card-meta">
                    <span>@evt.EventDate.ToString("dd/MM/yyyy") às @evt.StartTime.ToString("HH:mm")</span>
                    <span>@evt.Location</span>
                </div>
                <div class="card-actions">
                    <button type="button" class="btn secondary" data-modal-target="edit-@evt.Id">Editar</button>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@evt.Id"
                          class="js-confirm-delete" data-confirm-message="Excluir o evento @evt.Name?">
                        <button type="submit" class="danger">Excluir</button>
                    </form>
                </div>

                <dialog id="edit-@evt.Id" class="modal">
                    <h3>Editar evento</h3>
                    <form method="post" asp-page-handler="Edit" asp-route-id="@evt.Id">
                        <div class="field">
                            <label>Nome</label>
                            <input name="name" value="@evt.Name" required />
                        </div>
                        <div class="field">
                            <label>Categoria</label>
                            <input name="category" value="@evt.Category" required />
                        </div>
                        <div class="field">
                            <label>Descrição</label>
                            <textarea name="description">@evt.Description</textarea>
                        </div>
                        <div class="field">
                            <label>Data</label>
                            <input name="eventDate" type="date" value="@evt.EventDate.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="field">
                            <label>Horário</label>
                            <input name="startTime" type="time" value="@evt.StartTime.ToString("HH:mm")" required />
                        </div>
                        <div class="field">
                            <label>Local</label>
                            <input name="location" value="@evt.Location" required />
                        </div>
                        <div class="field">
                            <label>URL da foto</label>
                            <input name="imageUrl" type="url" value="@evt.ImageUrl" placeholder="https://..." />
                        </div>
                        <div class="field">
                            <label>Status</label>
                            <select name="isActive">
                                <option value="true" selected="@evt.IsActive">Ativo</option>
                                <option value="false" selected="@(!evt.IsActive)">Inativo</option>
                            </select>
                        </div>
                        <div class="modal-actions">
                            <button type="button" class="btn secondary" data-modal-close>Cancelar</button>
                            <button type="submit">Salvar alterações</button>
                        </div>
                    </form>
                </dialog>
            </div>
        }
    </div>
}
