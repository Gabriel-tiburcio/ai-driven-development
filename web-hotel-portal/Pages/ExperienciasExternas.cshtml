@page
@model ExperienciasExternasModel
@{
    ViewData["Title"] = "Experiências Externas";
    Layout = "_Layout";
}

<h1>Experiências Externas</h1>

<div class="card">
    <details>
        <summary>Nova experiência</summary>
        <form method="post" style="margin-top:1rem;">
            <div class="field">
                <label asp-for="Input.Name">Nome</label>
                <input asp-for="Input.Name" required />
            </div>
            <div class="field">
                <label asp-for="Input.Category">Categoria</label>
                <input asp-for="Input.Category" placeholder="Passeios, Mergulho, Trilhas..." required />
            </div>
            <div class="field">
                <label asp-for="Input.Description">Descrição</label>
                <textarea asp-for="Input.Description" required></textarea>
            </div>
            <div class="field">
                <label asp-for="Input.Price">Preço (R$)</label>
                <input asp-for="Input.Price" type="number" step="0.01" />
            </div>
            <div class="field">
                <label asp-for="Input.DurationLabel">Duração</label>
                <input asp-for="Input.DurationLabel" placeholder="4 horas, dia inteiro..." required />
            </div>
            <div class="field">
                <label asp-for="Input.Location">Local</label>
                <input asp-for="Input.Location" required />
            </div>
            <div class="field">
                <label asp-for="Input.ImageUrl">URL da foto</label>
                <input asp-for="Input.ImageUrl" type="url" placeholder="https://..." />
            </div>
            <button type="submit">Salvar</button>
        </form>
    </details>
</div>

@if (Model.Experiences.Count == 0)
{
    <p class="empty-note">Nenhuma experiência cadastrada ainda.</p>
}
else
{
    <div class="docket-wall">
        @foreach (var x in Model.Experiences)
        {
            <div class="docket-card">
                <div class="docket-card-photo">
                    @if (!string.IsNullOrWhiteSpace(x.ImageUrl))
                    {
                        <img src="@x.ImageUrl" alt="" />
                    }
                    else
                    {
                        <span class="docket-card-photo-empty">Sem foto</span>
                    }
                </div>
                <span class="docket-card-category">@x.Category</span>
                <h3>@x.Name</h3>
                <div class="docket-card-meta">
                    <span><strong>@x.Price.ToString("C")</strong></span>
                    <span>@x.DurationLabel &middot; @x.Location</span>
                </div>
                <div class="card-actions">
                    <button type="button" class="btn secondary" data-modal-target="edit-@x.Id">Editar</button>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@x.Id"
                          class="js-confirm-delete" data-confirm-message="Excluir a experiência @x.Name?">
                        <button type="submit" class="danger">Excluir</button>
                    </form>
                </div>

                <dialog id="edit-@x.Id" class="modal">
                    <h3>Editar experiência</h3>
                    <form method="post" asp-page-handler="Edit" asp-route-id="@x.Id">
                        <div class="field">
                            <label>Nome</label>
                            <input name="name" value="@x.Name" required />
                        </div>
                        <div class="field">
                            <label>Categoria</label>
                            <input name="category" value="@x.Category" required />
                        </div>
                        <div class="field">
                            <label>Descrição</label>
                            <textarea name="description" required>@x.Description</textarea>
                        </div>
                        <div class="field">
                            <label>Preço (R$)</label>
                            <input name="price" type="number" step="0.01" value="@x.Price" />
                        </div>
                        <div class="field">
                            <label>Duração</label>
                            <input name="durationLabel" value="@x.DurationLabel" required />
                        </div>
                        <div class="field">
                            <label>Local</label>
                            <input name="location" value="@x.Location" required />
                        </div>
                        <div class="field">
                            <label>URL da foto</label>
                            <input name="imageUrl" type="url" value="@x.ImageUrl" placeholder="https://..." />
                        </div>
                        <div class="field">
                            <label>Status</label>
                            <select name="isActive">
                                <option value="true" selected="@x.IsActive">Ativa</option>
                                <option value="false" selected="@(!x.IsActive)">Inativa</option>
                            </select>
                        </div>
                        <div class="modal-actions">
                            <button type="button" class="btn secondary" data-modal-close>Cancelar</button>
                            <button type="submit">Salvar alterações</button>
                        </div>
                    </form>
                </dialog>
            </div>
        }
    </div>
}

<h2 style="margin-top:2rem;">Solicitações de reserva</h2>

@if (Model.Requests.Count == 0)
{
    <p class="empty-note">Nenhuma solicitação recebida ainda.</p>
}
else
{
    <div class="docket-wall">
        @foreach (var r in Model.Requests)
        {
            <div class="docket-card">
                <span class="docket-card-category">@r.ExternalExperienceName</span>
                <h3>Quarto @r.RoomNumber &middot; @r.GuestName</h3>
                <div class="docket-card-meta">
                    <span><strong>@r.Status</strong></span>
                    <span>@r.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</span>
                </div>
            </div>
        }
    </div>
}
