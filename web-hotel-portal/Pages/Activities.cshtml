@page
@model ActivitiesModel
@{
    ViewData["Title"] = "Atividades";
    Layout = "_Layout";
}

<h1>Atividades</h1>

<div class="card">
    <details>
        <summary>Nova atividade</summary>
        <form method="post" style="margin-top:1rem;">
            <div class="field">
                <label asp-for="Input.Name">Nome</label>
                <input asp-for="Input.Name" required />
            </div>
            <div class="field">
                <label asp-for="Input.Category">Categoria</label>
                <input asp-for="Input.Category" placeholder="Spa, Passeios, Gastronomia..." required />
            </div>
            <div class="field">
                <label asp-for="Input.Description">Descrição</label>
                <textarea asp-for="Input.Description"></textarea>
            </div>
            <div class="field">
                <label asp-for="Input.Price">Preço (R$)</label>
                <input asp-for="Input.Price" type="number" step="0.01" />
            </div>
            <div class="field">
                <label asp-for="Input.DurationMinutes">Duração (minutos)</label>
                <input asp-for="Input.DurationMinutes" type="number" />
            </div>
            <div class="field">
                <label asp-for="Input.ImageUrl">URL da foto</label>
                <input asp-for="Input.ImageUrl" type="url" placeholder="https://..." />
            </div>
            <button type="submit">Salvar</button>
        </form>
    </details>
</div>

@if (Model.Activities.Count == 0)
{
    <p class="empty-note">Nenhuma atividade cadastrada ainda.</p>
}
else
{
    <div class="docket-wall">
        @foreach (var activity in Model.Activities)
        {
            <div class="docket-card">
                <div class="docket-card-photo">
                    @if (!string.IsNullOrWhiteSpace(activity.ImageUrl))
                    {
                        <img src="@activity.ImageUrl" alt="" />
                    }
                    else
                    {
                        <span class="docket-card-photo-empty">Sem foto</span>
                    }
                </div>
                <span class="docket-card-category">@activity.Category</span>
                <h3>@activity.Name</h3>
                <div class="docket-card-meta">
                    <span><strong>@(activity.Price == 0 ? "Incluso" : activity.Price.ToString("C"))</strong></span>
                    <span>@activity.DurationMinutes min</span>
                </div>
                <div class="docket-card-slots">
                    <strong>@activity.Slots.Sum(s => s.AvailableSpots)</strong> vagas futuras
                </div>
                <div class="card-actions">
                    <a asp-page="/ActivityDetail" asp-route-id="@activity.Id" class="btn secondary">Vagas</a>
                    <button type="button" class="btn secondary" data-modal-target="edit-@activity.Id">Editar</button>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@activity.Id"
                          class="js-confirm-delete" data-confirm-message="Excluir a atividade @activity.Name?">
                        <button type="submit" class="danger">Excluir</button>
                    </form>
                </div>

                <dialog id="edit-@activity.Id" class="modal">
                    <h3>Editar atividade</h3>
                    <form method="post" asp-page-handler="Edit" asp-route-id="@activity.Id">
                        <div class="field">
                            <label>Nome</label>
                            <input name="name" value="@activity.Name" required />
                        </div>
                        <div class="field">
                            <label>Categoria</label>
                            <input name="category" value="@activity.Category" required />
                        </div>
                        <div class="field">
                            <label>Descrição</label>
                            <textarea name="description">@activity.Description</textarea>
                        </div>
                        <div class="field">
                            <label>Preço (R$)</label>
                            <input name="price" type="number" step="0.01" value="@activity.Price" />
                        </div>
                        <div class="field">
                            <label>Duração (minutos)</label>
                            <input name="durationMinutes" type="number" value="@activity.DurationMinutes" />
                        </div>
                        <div class="field">
                            <label>URL da foto</label>
                            <input name="imageUrl" type="url" value="@activity.ImageUrl" placeholder="https://..." />
                        </div>
                        <div class="field">
                            <label>Status</label>
                            <select name="isActive">
                                <option value="true" selected="@activity.IsActive">Ativa</option>
                                <option value="false" selected="@(!activity.IsActive)">Inativa</option>
                            </select>
                        </div>
                        <div class="modal-actions">
                            <button type="button" class="btn secondary" data-modal-close>Cancelar</button>
                            <button type="submit">Salvar alterações</button>
                        </div>
                    </form>
                </dialog>
            </div>
        }
    </div>
}
