@page
@model ServicosModel
@{
    ViewData["Title"] = "Serviços";
    Layout = "_Layout";
}

<h1>Serviços</h1>

<div class="card">
    <details>
        <summary>Novo serviço</summary>
        <form method="post" style="margin-top:1rem;">
            <div class="field">
                <label asp-for="Input.Name">Nome</label>
                <input asp-for="Input.Name" required />
            </div>
            <div class="field">
                <label asp-for="Input.Category">Categoria</label>
                <input asp-for="Input.Category" placeholder="Spa, Fitness, Aulas..." required />
            </div>
            <div class="field">
                <label asp-for="Input.Description">Descrição</label>
                <textarea asp-for="Input.Description" required></textarea>
            </div>
            <div class="field">
                <label asp-for="Input.Price">Preço (R$)</label>
                <input asp-for="Input.Price" type="number" step="0.01" />
            </div>
            <div class="field">
                <label asp-for="Input.DurationMinutes">Duração (minutos)</label>
                <input asp-for="Input.DurationMinutes" type="number" />
            </div>
            <div class="field">
                <label asp-for="Input.ImageUrl">URL da foto</label>
                <input asp-for="Input.ImageUrl" type="url" placeholder="https://..." />
            </div>
            <button type="submit">Salvar</button>
        </form>
    </details>
</div>

@if (Model.Services.Count == 0)
{
    <p class="empty-note">Nenhum serviço cadastrado ainda.</p>
}
else
{
    <div class="docket-wall">
        @foreach (var s in Model.Services)
        {
            <div class="docket-card">
                <div class="docket-card-photo">
                    @if (!string.IsNullOrWhiteSpace(s.ImageUrl))
                    {
                        <img src="@s.ImageUrl" alt="" />
                    }
                    else
                    {
                        <span class="docket-card-photo-empty">Sem foto</span>
                    }
                </div>
                <span class="docket-card-category">@s.Category</span>
                <h3>@s.Name</h3>
                <div class="docket-card-meta">
                    <span><strong>@s.Price.ToString("C")</strong></span>
                    <span>@s.DurationMinutes min</span>
                </div>
                <div class="card-actions">
                    <button type="button" class="btn secondary" data-modal-target="edit-@s.Id">Editar</button>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@s.Id"
                          class="js-confirm-delete" data-confirm-message="Excluir o serviço @s.Name?">
                        <button type="submit" class="danger">Excluir</button>
                    </form>
                </div>

                <dialog id="edit-@s.Id" class="modal">
                    <h3>Editar serviço</h3>
                    <form method="post" asp-page-handler="Edit" asp-route-id="@s.Id">
                        <div class="field">
                            <label>Nome</label>
                            <input name="name" value="@s.Name" required />
                        </div>
                        <div class="field">
                            <label>Categoria</label>
                            <input name="category" value="@s.Category" required />
                        </div>
                        <div class="field">
                            <label>Descrição</label>
                            <textarea name="description" required>@s.Description</textarea>
                        </div>
                        <div class="field">
                            <label>Preço (R$)</label>
                            <input name="price" type="number" step="0.01" value="@s.Price" />
                        </div>
                        <div class="field">
                            <label>Duração (minutos)</label>
                            <input name="durationMinutes" type="number" value="@s.DurationMinutes" />
                        </div>
                        <div class="field">
                            <label>URL da foto</label>
                            <input name="imageUrl" type="url" value="@s.ImageUrl" placeholder="https://..." />
                        </div>
                        <div class="field">
                            <label>Status</label>
                            <select name="isActive">
                                <option value="true" selected="@s.IsActive">Ativo</option>
                                <option value="false" selected="@(!s.IsActive)">Inativo</option>
                            </select>
                        </div>
                        <div class="modal-actions">
                            <button type="button" class="btn secondary" data-modal-close>Cancelar</button>
                            <button type="submit">Salvar alterações</button>
                        </div>
                    </form>
                </dialog>
            </div>
        }
    </div>
}

<h2 style="margin-top:2rem;">Solicitações de contratação</h2>

@if (Model.Requests.Count == 0)
{
    <p class="empty-note">Nenhuma solicitação recebida ainda.</p>
}
else
{
    <div class="docket-wall">
        @foreach (var r in Model.Requests)
        {
            <div class="docket-card">
                <span class="docket-card-category">@r.ServiceName</span>
                <h3>Quarto @r.RoomNumber &middot; @r.GuestName</h3>
                <div class="docket-card-meta">
                    <span><strong>@r.Status</strong></span>
                    <span>@r.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</span>
                </div>
            </div>
        }
    </div>
}
