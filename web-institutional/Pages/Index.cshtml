@page
@model IndexModel
@{
    ViewData["Title"] = "AllStay — Concierge digital para hotéis";
}

<section class="hero">
    <div class="container">
        <span class="claim-eyebrow">Concierge digital para hotéis 4 e 5 estrelas</span>
        <h1 class="claim-heading">O hóspede não devia precisar ir até a recepção.</h1>
        <p class="claim-sub">
            AllStay centraliza spa, passeios, restaurantes e eventos do hotel em um app mobile-first —
            acessado por QR code, sem instalação.
        </p>
        <div class="hero-actions">
            <a asp-page="/Contact" class="btn btn-brand btn-lg">Falar com vendas</a>
            <a href="#precos" class="btn-text">Ver planos ›</a>
        </div>
        <div class="device-frame">
            <div class="screen">
                <div class="notch"></div>
                <div class="mock-status"><span class="dot"></span><span class="dot"></span><span class="dot"></span></div>
                <div class="mock-title"><strong>Hotel Aurora</strong><span>O que você quer aproveitar hoje?</span></div>
                <div class="mock-chips">
                    <span class="mock-chip on">Tudo</span>
                    <span class="mock-chip">Spa</span>
                    <span class="mock-chip">Passeios</span>
                </div>
                <div class="mock-cards">
                    <div class="mock-card lit">
                        <span class="tag">Spa</span>
                        <div class="t">Massagem relaxante</div>
                        <div class="m"><span>60 min</span><span class="price">R$ 180</span></div>
                    </div>
                    <div class="mock-card">
                        <span class="tag">Passeios</span>
                        <div class="t">Passeio de escuna</div>
                        <div class="m"><span>3h</span><span class="price">R$ 120</span></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <span class="claim-eyebrow">Como funciona</span>
        <h2 class="claim-heading">Da recepção para o bolso do hóspede.</h2>
        <p class="claim-sub">Três passos, sem intermediário.</p>
        <div class="proof-visual">
            <div class="proof-steps">
                <div class="proof-step">
                    <div class="n">01</div>
                    <div class="t">Escaneia o QR code do quarto</div>
                </div>
                <span class="proof-arrow">→</span>
                <div class="proof-step">
                    <div class="n">02</div>
                    <div class="t">Escolhe horário e reserva</div>
                </div>
                <span class="proof-arrow">→</span>
                <div class="proof-step">
                    <div class="n">03</div>
                    <div class="t">Cobrado na conta do quarto</div>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="produto" class="section section-alt">
    <div class="container">
        <span class="claim-eyebrow">Por que hotéis escolhem o AllStay</span>
        <h2 class="claim-heading">Tudo o que a recepção fazia manualmente, automático.</h2>
        <div class="tile-grid mt-5">
            <div class="tile">
                <h3>Catálogo centralizado</h3>
                <p>Todas as atividades, horários, preços e vagas do hotel em um único lugar — sem folders, placas ou informação fragmentada.</p>
                <div class="tile-visual">
                    <div class="stat">1<span class="accent">/1</span></div>
                    <div class="cap">app para spa, passeios, restaurantes e eventos</div>
                </div>
            </div>
            <div class="tile">
                <h3>Reserva em tempo real</h3>
                <p>O hóspede filtra por categoria, horário e preço, e reserva em segundos — sem depender da recepção ou do concierge.</p>
                <div class="tile-visual">
                    <div class="stat">&lt;30<span class="accent">s</span></div>
                    <div class="cap">do catálogo à reserva confirmada</div>
                </div>
            </div>
            <div class="tile">
                <h3>Aumento de ticket médio</h3>
                <p>Descoberta guiada de experiências pagas aumenta o consumo de serviços e a percepção de valor da estadia.</p>
                <div class="tile-visual">
                    <div class="stat"><span class="accent">↑</span> NPS</div>
                    <div class="cap">mais consumo, mais satisfação</div>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="precos" class="section dark-section">
    <div class="container">
        <span class="claim-eyebrow">Planos</span>
        <h2 class="claim-heading">Um plano para cada porte de hotel.</h2>
        <p class="claim-sub">Assinatura mensal por hotel. Sem taxas de implantação escondidas.</p>
        <div class="price-grid mt-5">
            <div class="price-card">
                <div class="price-tier">Essential</div>
                <p class="price-figure">R$ 5.000<span class="per">/mês</span></p>
                <p class="price-note">a partir de</p>
                <ul class="price-list">
                    <li>Catálogo de atividades e reservas</li>
                    <li>Acesso via QR code / link</li>
                    <li>Backoffice para gestão de vagas</li>
                    <li>Suporte por e-mail</li>
                </ul>
                <a asp-page="/Contact" class="btn btn-outline-light w-100">Falar com vendas</a>
            </div>
            <div class="price-card is-featured">
                <span class="price-badge">Mais popular</span>
                <div class="price-tier">Professional</div>
                <p class="price-figure">R$ 10.000<span class="per">/mês</span></p>
                <p class="price-note">a partir de</p>
                <ul class="price-list">
                    <li>Tudo do Essential</li>
                    <li>Analytics de uso e consumo</li>
                    <li>Suporte prioritário e treinamento</li>
                    <li>Recomendações personalizadas</li>
                </ul>
                <a asp-page="/Contact" class="btn btn-outline-light w-100">Falar com vendas</a>
            </div>
            <div class="price-card">
                <div class="price-tier">Enterprise</div>
                <p class="price-figure">R$ 15.000<span class="per">/mês</span></p>
                <p class="price-note">a partir de</p>
                <ul class="price-list">
                    <li>Tudo do Professional</li>
                    <li>Serviços especializados</li>
                    <li>SLA dedicado</li>
                    <li>Squad dedicada sob contrato (redes hoteleiras)</li>
                </ul>
                <a asp-page="/Contact" class="btn btn-outline-light w-100">Falar com vendas</a>
            </div>
        </div>
    </div>
</section>
