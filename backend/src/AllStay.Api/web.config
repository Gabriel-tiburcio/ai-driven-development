<?xml version="1.0" encoding="utf-8"?>
<!--
  Base template for IIS/Plesk (HostAzul). `dotnet publish` rewrites processPath/
  arguments for the target build automatically but preserves the custom nodes below.

  Secrets (DB connection string, JWT signing key, admin API key) currently live in
  appsettings.Production.json instead of here, for simplicity. If you'd rather keep
  secrets out of any file on disk, move them to Plesk's "Environment Variables" panel
  or the commented <environmentVariable> lines below instead, and blank them back out
  of appsettings.Production.json.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath=".\AllStay.Api.exe" stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <!-- <environmentVariable name="ConnectionStrings__Default" value="" /> -->
          <!-- <environmentVariable name="Jwt__SigningKey" value="" /> -->
          <!-- <environmentVariable name="Admin__ApiKey" value="" /> -->
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
