<Project>
  <!--
    Portable (framework-dependent) publish for HostAzul (Windows/Plesk/IIS): the
    server must have the .NET 8 Hosting Bundle/runtime installed. Smaller output
    than self-contained. Run with:
      dotnet publish -p:PublishProfile=HostAzul -c Release
  -->
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishDir>bin\Release\net8.0\win-x64\publish\</PublishDir>
    <EnvironmentName>Production</EnvironmentName>
    <WebPublishMethod>Custom</WebPublishMethod>
    <LastUsedBuildConfiguration />
    <LastUsedPlatform />
    <ProjectGuid>39bc9b1c-4ab8-4fee-96bb-d4b075f9bad5</ProjectGuid>
  </PropertyGroup>
</Project>