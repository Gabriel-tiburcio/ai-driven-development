@page "/activities/{ActivityId:guid}"
@rendermode InteractiveServer
@inject ApiClient Api
@inject AuthState AuthState
@inject NavigationManager Nav

@if (!AuthState.IsAuthenticated)
{
    <p>Redirecionando para login...</p>
}
else if (loading)
{
    <p>Carregando...</p>
}
else if (activity is null)
{
    <p>Atividade não encontrada.</p>
}
else
{
    <a href="/activities">&larr; Voltar para atividades</a>
    <h1>@activity.Name</h1>
    <p>@activity.Description</p>

    <div class="card">
        <h3>Novo horário</h3>
        <EditForm Model="slotModel" OnValidSubmit="HandleAddSlot">
            <div class="field">
                <label>Data e hora</label>
                <InputDate @bind-Value="slotModel.Date" />
                <input type="time" @bind="slotModel.Time" />
            </div>
            <div class="field">
                <label>Capacidade</label>
                <InputNumber @bind-Value="slotModel.Capacity" />
            </div>
            <button type="submit">Adicionar horário</button>
        </EditForm>
    </div>

    <table>
        <thead>
            <tr>
                <th>Data/Hora</th>
                <th>Capacidade</th>
                <th>Reservados</th>
                <th>Disponíveis</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var slot in activity.Slots.OrderBy(s => s.StartTime))
            {
                <tr>
                    <td>@slot.StartTime.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@slot.Capacity</td>
                    <td>@slot.BookedCount</td>
                    <td>@slot.AvailableSpots</td>
                    <td><button class="danger" @onclick="() => HandleDeleteSlot(slot.Id)">Remover</button></td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [Parameter] public Guid ActivityId { get; set; }

    private ActivityDto? activity;
    private bool loading = true;
    private SlotModel slotModel = new();

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsAuthenticated)
        {
            Nav.NavigateTo("/login", replace: true);
            return;
        }

        await LoadActivity();
    }

    private async Task LoadActivity()
    {
        loading = true;
        activity = await Api.GetActivityAsync(AuthState.Staff!.HotelId, ActivityId);
        loading = false;
    }

    private async Task HandleAddSlot()
    {
        var startTime = new DateTimeOffset(slotModel.Date.ToDateTime(slotModel.Time), TimeSpan.Zero);
        var request = new CreateActivitySlotRequest(startTime, slotModel.Capacity);
        var ok = await Api.AddSlotAsync(AuthState.Staff!.HotelId, ActivityId, request);
        if (ok)
        {
            slotModel = new SlotModel();
            await LoadActivity();
        }
    }

    private async Task HandleDeleteSlot(Guid slotId)
    {
        var ok = await Api.DeleteSlotAsync(AuthState.Staff!.HotelId, ActivityId, slotId);
        if (ok) await LoadActivity();
    }

    public class SlotModel
    {
        public DateOnly Date { get; set; } = DateOnly.FromDateTime(DateTime.Today);
        public TimeOnly Time { get; set; } = new(9, 0);
        public int Capacity { get; set; } = 8;
    }
}
