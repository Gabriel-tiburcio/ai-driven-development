@page "/reservations"
@rendermode InteractiveServer
@inject ApiClient Api
@inject AuthState AuthState
@inject NavigationManager Nav

<h1>Reservas</h1>

@if (!AuthState.IsAuthenticated)
{
    <p>Redirecionando para login...</p>
}
else if (loading)
{
    <p>Carregando...</p>
}
else if (reservations.Count == 0)
{
    <p>Nenhuma reserva ainda.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Atividade</th>
                <th>Horário</th>
                <th>Hóspede</th>
                <th>Quarto</th>
                <th>Status</th>
                <th>Criada em</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in reservations)
            {
                <tr>
                    <td>@r.ActivityName</td>
                    <td>@r.SlotStartTime.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@r.GuestName</td>
                    <td>@r.RoomNumber</td>
                    <td><span class="badge">@r.Status</span></td>
                    <td>@r.CreatedAt.LocalDateTime.ToString("dd/MM HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<ReservationDto> reservations = [];
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsAuthenticated)
        {
            Nav.NavigateTo("/login", replace: true);
            return;
        }

        reservations = await Api.GetReservationsAsync(AuthState.Staff!.HotelId);
        loading = false;
    }
}
